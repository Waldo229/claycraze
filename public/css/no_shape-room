/* =========================================
   SHAPE ROOM
========================================= */

.shape-room-page {
  width: 100%;
  min-height: 100vh;
}

/* =========================================
   HERO
========================================= */

.room-hero {
  max-width: 900px;
  margin: 5rem auto 3rem;
  padding: 0 2rem;
  text-align: center;
}

.room-kicker {
  margin-bottom: 1rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.72rem;
  opacity: 0.7;
}

.room-hero h1 {
  margin-bottom: 1.25rem;
  font-size: clamp(2.8rem, 6vw, 5rem);
  font-weight: 400;
  line-height: 1;
}

.room-hero p {
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.8;
  opacity: 0.82;
}

/* =========================================
   GRID
========================================= */

.shape-grid {
  width: min(1500px, 100%);
  margin: 0 auto 6rem;
  padding: 0 2rem;

  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 2.5rem;
}

/* =========================================
   TILE
========================================= */

.shape-tile {
  position: relative;
  display: block;

  overflow: hidden;
  border-radius: 24px;

  background: #1c1815;

  text-decoration: none;
  color: inherit;

  box-shadow:
    0 10px 30px rgba(0,0,0,.20),
    0 20px 60px rgba(0,0,0,.35);

  transition:
    transform .35s ease,
    box-shadow .35s ease;
}

.shape-tile:hover {
  transform: translateY(-4px);

  box-shadow:
    0 14px 40px rgba(0,0,0,.28),
    0 28px 80px rgba(0,0,0,.42);
}

.shape-image-wrap {
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.shape-image-wrap img {
  width: 100%;
  height: 100%;

  display: block;
  object-fit: cover;

  transition: transform .6s ease;
}

.shape-tile:hover img {
  transform: scale(1.03);
}

/* =========================================
   LABEL
========================================= */

.shape-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  padding: 1.2rem 1.25rem;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.82),
      rgba(0,0,0,.45),
      transparent
    );

  color: #f4efe8;
}

.shape-piece-number {
  display: block;
  margin-bottom: 0.35rem;

  font-size: 1rem;
  letter-spacing: 0.04em;
}

.shape-dimensions {
  display: block;

  font-size: 0.85rem;
  opacity: 0.8;
}

/* =========================================
   LOADING / EMPTY
========================================= */

.shape-loading,
.shape-empty {
  opacity: 0.7;
  text-align: center;
  padding: 4rem 1rem;
}
/* =========================================================
   SITE SEARCH
========================================================= */

.site-search {
  max-width: 760px;
  margin: 4rem auto 0;
  padding: 1.5rem;
  border-radius: 24px;
  background: rgba(255, 248, 232, 0.045);
  border: 1px solid rgba(242, 230, 201, 0.08);
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
}

.site-search label {
  display: block;
  margin-bottom: 0.75rem;
  color: var(--gold);
  font-size: 0.8rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.site-search input {
  width: 100%;
  padding: 0.9rem 1rem;
  border-radius: 999px;
  border: 1px solid rgba(242, 230, 201, 0.18);
  background: rgba(20, 12, 6, 0.74);
  color: #f4e8cc;
  font-family: inherit;
  font-size: 1rem;
}

.site-search input::placeholder {
  color: rgba(234, 223, 200, 0.45);
}

.site-search-results {
  margin-top: 1rem;
  color: var(--muted);
  font-size: 0.95rem;
}

.site-search-result {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.85rem 0;
  border-top: 1px solid rgba(242, 230, 201, 0.08);
  text-decoration: none;
}

.site-search-result:first-child {
  border-top: 0;
}

.site-search-result img {
  width: 56px;
  height: 56px;
  object-fit: cover;
  border-radius: 12px;
  background: rgba(255, 248, 232, 0.06);
}

.site-search-result strong {
  display: block;
  color: #f4e8cc;
  font-size: 1rem;
  font-weight: 400;
}

.site-search-result small {
  display: block;
  margin-top: 0.25rem;
  color: rgba(234, 223, 200, 0.58);
}
/* =========================================
   MOBILE
========================================= */

@media (max-width: 640px) {

  .shape-grid {
    padding: 0 1rem;
    gap: 1.5rem;
  }

  .room-hero {
    margin-top: 3rem;
    padding: 0 1.25rem;
  }

}